# You should not need this file. `./install.sh` writes a .env for you, and
# everything else - community name, owner account, invite codes - is set up in
# the browser on first visit.
#
# It's here for people who'd rather do it by hand. Copy to `.env`.

# ── required ─────────────────────────────────────────────────────────────────

# Where your community lives. Must already resolve to this machine's public IP:
# Caddy proves ownership of it to Let's Encrypt to get a TLS certificate.
# A free dynamic-DNS name (DuckDNS etc.) works fine on a home connection.
MOTUS_DOMAIN=chat.example.com

# Shared secret between the app and the voice server. Nobody ever types this -
# generate one and forget it:  openssl rand -hex 32
LIVEKIT_API_SECRET=

# ── optional ─────────────────────────────────────────────────────────────────

# The published image. Pin a version (…:v1.2.3) instead of latest if you'd
# rather upgrade deliberately.
#MOTUS_IMAGE=ghcr.io/lucien-n/motus:latest
#LIVEKIT_API_KEY=motus

# Skip the browser setup wizard and create the owner from the environment
# instead. Only for scripted installs; leave these empty otherwise.
#COMMUNITY_NAME=My Community
#OWNER_USERNAME=owner
#OWNER_PASSWORD=
# Lost the owner password? Set it above, set this to 1, start once, then unset.
#RESET_OWNER_PASSWORD=

# Point the browser at a LiveKit that is NOT behind our reverse proxy. Normally
# unset: the server derives wss://$MOTUS_DOMAIN/livekit from the request itself.
# Needed for local dev, where there is no proxy:
#LIVEKIT_URL=ws://localhost:7880

# The database backs itself up on a timer, into data/backups. These control how
# often, and how many to keep before the oldest are cleared out. Set the hours to
# 0 to turn automatic backups off (you can still take one by hand from the system
# panel). Watch them and download them there too.
#BACKUP_INTERVAL_HOURS=24
#BACKUP_RETENTION=7

# Message attachments (any file, images included) are written here. Point this at
# a big external disk to keep large transfers off the primary volume - the small
# assets and the database stay put. Absolute path; defaults to data/attachments.
#ATTACHMENTS_DIR=/mnt/ssd/motus/attachments
# Files larger than this get an expiry so a few big transfers can't slowly fill
# the disk; smaller ones are kept forever. Set the days to 0 to keep everything.
#ATTACHMENT_TTL_THRESHOLD_MB=25
#ATTACHMENT_TTL_DAYS=30
# How often the server scans for and reclaims expired attachments, in minutes.
#ATTACHMENT_SWEEP_INTERVAL_MIN=60
